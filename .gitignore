# Python bytecode
__pycache__/
*.py[cod]

# Local virtual environments (keep environment specification files trackable)
/.venv/
/venv/
/env/

# Packaging artifacts
/build/
/dist/
*.egg-info/
/.eggs/

# Test, lint, and coverage artifacts
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
/coverage.xml
/htmlcov/

# MkDocs build output; docs/architecture/*.dot and *.svg stay version-controlled
/site/

# Generated runtime products (curated reference data belongs outside these paths)
/outputs/
/figs/
/logs/

# Local HelioSwarm mission inputs; do not ignore other data/ content
/data/helioswarm_cdf/

# Logs and disposable editor/OS artifacts
*.log
*~
*.swp
*.swo
.DS_Store
*.sh

#The individual generation and analysis scripts
analysis/*.yaml
generation/*.yaml

